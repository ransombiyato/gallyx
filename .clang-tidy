# SPDX-License-Identifier: Apache-2.0
# clang-tidy configuration for Project HYPERION.
#
# Kept intentionally focused: correctness and portability checks that matter
# for a translator, not stylistic noise.
---
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  portability-*,
  readability-braces-around-statements,
  modernize-use-nullptr,
  modernize-use-override,
  cppcoreguidelines-pro-type-reinterpret-cast
WarningsAsErrors: ''
HeaderFilterRegex: 'include/hyperion/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
