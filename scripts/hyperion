#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Project HYPERION - the `hyperion` command.
#
# Installed by install.sh. Reads its configuration from
# <prefix>/share/hyperion/install.conf, which records the source checkout and
# build tree chosen at install time.
#
# This is a thin, honest front end: every command runs real functionality in
# the build tree or reports clearly what is not implemented yet.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "${SELF}" ]; do
    target="$(readlink "${SELF}")"
    case "${target}" in
        /*) SELF="${target}" ;;
        *)  SELF="$(dirname "${SELF}")/${target}" ;;
    esac
done
BIN_DIR="$(cd "$(dirname "${SELF}")" && pwd)"
PREFIX="$(cd "${BIN_DIR}/.." && pwd)"

CONF="${HYPERION_INSTALL_CONF:-${PREFIX}/share/hyperion/install.conf}"

if [ -n "${HYPERION_SRC:-}" ]; then
    SRC="${HYPERION_SRC}"
elif [ -f "${CONF}" ]; then
    SRC="$(sed -n 's/^HYPERION_SRC=//p' "${CONF}" | head -1)"
else
    # Running straight from a checkout: fall back to the repo this file is in.
    SRC="$(cd "${BIN_DIR}/.." && pwd)"
fi

if [ -n "${HYPERION_BUILD_DIR:-}" ]; then
    BUILD="${HYPERION_BUILD_DIR}"
elif [ -f "${CONF}" ]; then
    BUILD="$(sed -n 's/^HYPERION_BUILD_DIR=//p' "${CONF}" | head -1)"
else
    BUILD="${SRC}/build/dev"
fi

BENCH_BIN="${BUILD}/benchmarks/hyperion_bench"

say() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

need_checkout() {
    [ -d "${SRC}" ] || die "source checkout not found at '${SRC}' (re-run install.sh)"
}

need_build() {
    need_checkout
    [ -d "${BUILD}" ] || die "no build tree at '${BUILD}' (run: hyperion build)"
}

need_bench() {
    need_build
    [ -x "${BENCH_BIN}" ] || die "benchmark harness not built (run: hyperion build)"
}

cmd_help() {
    cat <<'EOF'
hyperion - experimental x86-64 -> AArch64 user-mode dynamic binary translator

usage: hyperion <command> [options]

status
  status        what is implemented, and what is not
  doctor        check the host, toolchain and install
  version       print version and build information

build and test
  build         build the project (Release)
  test          run the test suite
  bench         run the benchmark harness
  cross-test    build and run the AArch64 tests under qemu-user (if available)
  clean         remove this install's build tree

paths
  src           print the source checkout path
  build-dir     print the build tree path

translator
  run <exe>     execute a static x86-64 ELF64 binary or raw code blob (tier 0/1)
  info <exe>    inspect an x86-64 ELF64 executable

  help          show this message

'hyperion bench --help' shows the benchmark options.
'hyperion run --help' shows the run options.
EOF
}

cmd_version() {
    if [ -x "${BUILD}/hyperion" ]; then
        "${BUILD}/hyperion" --version
    fi
    say "source: ${SRC}"
    say "build:  ${BUILD}"
}

cmd_status() {
    cat <<'EOF'
Project HYPERION - status

Phase 0  foundation                  COMPLETE
Phase 1  baseline and benchmarks     COMPLETE
Phase 2  minimal instruction exec    IN PROGRESS (subset)
Phase 3  first native code gen       IN PROGRESS
Phase 4  basic dynamic translator    CORE DONE
Phase 5  performance and opt         IN PROGRESS
Phase 6  Linux ABI / syscalls        IN PROGRESS
Phase 7+ advanced CPU compatibility  NOT STARTED

IMPLEMENTED
  - CMake build, CI, unit tests, cross tests, sanitizers
  - host probe (arch, kernel, page size, cache line)
  - benchmark harness (`hyperion_bench` and `hyperion_tier_bench`)
  - AArch64 cross-build + test under qemu-user
  - x86-64 decoder + reference interpreter for a documented subset
  - AArch64 code generator and block translation cache (tier 1)
  - per-block guest-register allocation & W^X executable code cache
  - static x86-64 ELF64 (`ET_EXEC` / `ET_DYN`) loader, System V initial stack,
    `hyperion info`, and Linux syscall emulation slices

NOT IMPLEMENTED
  - dynamic linking (`PT_INTERP` / `ld-linux-x86-64.so.2`)
  - SIMD/FPU, signals, threads (`clone`/`futex`), full Linux ABI

Static x86-64 Linux ELF64 binaries (within the modelled ISA/syscall subset) and
raw x86-64 code blobs run with 'hyperion run <file>' (tier 1 on an AArch64 host,
tier 0 fallback otherwise). See STATUS.md and COMPATIBILITY.md for full details.
EOF
}

cmd_doctor() {
    say "Project HYPERION - environment check"
    say ""
    say "install"
    say "  prefix      : ${PREFIX}"
    say "  config      : ${CONF} $( [ -f "${CONF}" ] && echo '(found)' || echo '(not found)' )"
    say "  source      : ${SRC} $( [ -d "${SRC}" ] && echo '(found)' || echo '(MISSING)' )"
    say "  build tree  : ${BUILD} $( [ -d "${BUILD}" ] && echo '(found)' || echo '(not built)' )"
    say ""
    say "host"
    say "  os          : $(uname -s) $(uname -r)"
    say "  arch        : $(uname -m)"
    if [ -r /proc/cpuinfo ]; then
        model="$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)"
        [ -n "${model}" ] && say "  cpu         : ${model}"
        say "  logical cpus: $(grep -c '^processor' /proc/cpuinfo)"
    fi
    if [ -r /proc/meminfo ]; then
        say "  memory      : $(sed -n 's/^MemTotal:[[:space:]]*//p' /proc/meminfo | head -1)"
    fi
    say ""
    say "toolchain"
    for t in cmake ninja c++ g++ clang++ aarch64-linux-gnu-g++ qemu-aarch64 git; do
        if command -v "$t" >/dev/null 2>&1; then
            say "  $(printf '%-22s' "${t}") $(command -v "$t")"
        else
            say "  $(printf '%-22s' "${t}") (not found)"
        fi
    done
    say ""
    say "notes"
    if ! command -v aarch64-linux-gnu-g++ >/dev/null 2>&1; then
        say "  - no AArch64 cross compiler: 'hyperion cross-test' is unavailable."
        say "    This is expected on a target AArch64 device."
    fi
    if [ ! -x "${BENCH_BIN}" ]; then
        say "  - benchmark harness not built: run 'hyperion build'."
    fi
    if [ "$(uname -m)" = "aarch64" ]; then
        say "  - AArch64 host detected: Tier 1 native code generation is active."
    else
        say "  - non-AArch64 host: 'hyperion run' falls back to Tier 0 interpreter"
        say "    (use 'hyperion cross-test' to exercise Tier 1 AArch64 codegen via qemu-user)."
    fi
}

cmd_build() {
    need_checkout
    say "Configuring ${BUILD} (Release)"
    cmake -S "${SRC}" -B "${BUILD}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DHYPERION_WARNINGS_AS_ERRORS=ON >/dev/null
    say "Building"
    cmake --build "${BUILD}"
    say "Build complete."
}

cmd_test() {
    need_build
    ctest --test-dir "${BUILD}" --output-on-failure
}

cmd_bench() {
    need_bench
    exec "${BENCH_BIN}" "$@"
}

cmd_cross_test() {
    need_checkout
    command -v aarch64-linux-gnu-g++ >/dev/null 2>&1 \
        || die "no AArch64 cross compiler; this command needs one (and qemu-user)"
    command -v qemu-aarch64 >/dev/null 2>&1 \
        || die "qemu-aarch64 not found; install qemu-user"
    local dir="${SRC}/build/cross-test"
    cmake -S "${SRC}" -B "${dir}" -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DHYPERION_ENABLE_CROSS_TESTS=ON \
        -DHYPERION_AARCH64_CXX=aarch64-linux-gnu-g++ \
        -DHYPERION_QEMU_AARCH64=qemu-aarch64 \
        -DHYPERION_BUILD_BENCHMARKS=OFF >/dev/null
    cmake --build "${dir}"
    ctest --test-dir "${dir}" --output-on-failure
}

cmd_clean() {
    need_checkout
    say "Removing ${BUILD}"
    rm -rf "${BUILD}"
}

cmd_run() {
    need_build
    local bin="${BUILD}/hyperion"
    [ -x "${bin}" ] || die "hyperion binary not found at '${bin}' (run: hyperion build)"
    exec "${bin}" run "$@"
}

cmd_info() {
    need_build
    local bin="${BUILD}/hyperion"
    [ -x "${bin}" ] || die "hyperion binary not found at '${bin}' (run: hyperion build)"
    exec "${bin}" info "$@"
}

case "${1:-}" in
    ""|-h|--help|help)  cmd_help ;;
    status)             cmd_status ;;
    version)            cmd_version ;;
    doctor)             cmd_doctor ;;
    build)              cmd_build ;;
    test)               cmd_test ;;
    bench)              shift; cmd_bench "$@" ;;
    cross-test)         cmd_cross_test ;;
    clean)              cmd_clean ;;
    src)                say "${SRC}" ;;
    build-dir)          say "${BUILD}" ;;
    run)                shift; cmd_run "$@" ;;
    info)               shift; cmd_info "$@" ;;
    *)                  printf 'error: unknown command %s\n\n' "$1" >&2; cmd_help >&2; exit 1 ;;
esac
